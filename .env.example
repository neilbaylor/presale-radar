# Required
DATABASE_URL=postgresql://...        # Railway fills this when you reference the Postgres service
TM_API_KEY=                          # Ticketmaster Discovery API key (developer.ticketmaster.com)

# Push notifications (run `npm run vapid` and paste both lines)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional but recommended
BRAVE_API_KEY=                       # web search for presale codes
REDDIT_CLIENT_ID=                    # optional: free Reddit "script" app, so Reddit doesn't block the server
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=                      # optional, paid: X API (about $0.005 per post read)
X_DAILY_POSTS=300                    # cap on X posts read per day (300 is about $1.50)
SEATGEEK_CLIENT_ID=                  # resale prices + shows sold outside Ticketmaster (seatgeek.com/account/develop)
TM_INVENTORY_API_KEY=                # sold-out watch, once Ticketmaster approves access
APP_SECRET=                          # signs notification buttons; generated if unset

# Location and tuning (defaults shown)
HOME_LAT=43.6532
HOME_LON=-79.3832
RADIUS_KM=80
TIMEZONE=America/Toronto
MUSIC_ONLY=1
SYNC_INTERVAL_MIN=60
TICK_SECONDS=300
CODE_SCRAPE_INTERVAL_MIN=180

# DEMO=1 runs with made-up shows and no Ticketmaster key (in-memory DB if no DATABASE_URL)
