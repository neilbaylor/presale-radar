    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.20",
    "pg": "^8.23.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
